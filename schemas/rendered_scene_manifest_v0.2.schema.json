{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jibscan.org/schemas/rendered_scene_manifest/v0.2",
  "title": "RenderedSceneManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "image", "camera", "background", "objects", "geometry_manifest_path", "renderer"],
  "properties": {
    "schema_version": {"const": "jibscan.rendered_scene/v0.2"},
    "scene_id": {"type": "string", "minLength": 1},
    "image": {"$ref": "#/$defs/image"},
    "camera": {"$ref": "#/$defs/camera"},
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgba", "policy"],
      "properties": {
        "rgba": {"$ref": "#/$defs/rgba"},
        "policy": {"enum": ["constant", "invalid"]},
        "range_m": {"type": "number", "exclusiveMinimum": 0}
      },
      "if": {
        "properties": {"policy": {"const": "constant"}},
        "required": ["policy"]
      },
      "then": {
        "required": ["range_m"]
      },
      "else": {
        "not": {"required": ["range_m"]}
      }
    },
    "objects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["object_id", "source_instance_id", "z_index", "original_input_index", "transform"], "properties": {"object_id": {"type": "string"}, "source_instance_id": {"type": "string"}, "z_index": {"type": "number"}, "original_input_index": {"type": "integer", "minimum": 0}, "transform": {"$ref": "#/$defs/transform"}}}},
    "geometry_manifest_path": {"type": "string", "minLength": 1},
    "renderer": {"type": "object", "additionalProperties": false, "required": ["implementation", "version"], "properties": {"implementation": {"type": "string"}, "version": {"type": "string"}}}
  },
  "$defs": {
    "camera": {"type": "object", "additionalProperties": false, "required": ["fx", "fy", "cx", "cy", "width_px", "height_px"], "properties": {"fx": {"type": "number", "exclusiveMinimum": 0}, "fy": {"type": "number", "exclusiveMinimum": 0}, "cx": {"type": "number"}, "cy": {"type": "number"}, "width_px": {"type": "integer", "minimum": 1}, "height_px": {"type": "integer", "minimum": 1}}},
    "rgba": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}], "items": false},
    "image": {"type": "object", "additionalProperties": false, "required": ["rgba_path", "width_px", "height_px", "format", "dtype", "color_space", "alpha_mode", "channel_range"], "properties": {"rgba_path": {"type": "string", "minLength": 1}, "width_px": {"type": "integer", "minimum": 1}, "height_px": {"type": "integer", "minimum": 1}, "format": {"const": "PNG"}, "dtype": {"const": "uint8"}, "color_space": {"const": "sRGB"}, "alpha_mode": {"const": "straight"}, "channel_range": {"const": [0, 255]}}},
    "transform": {
      "type": "object", "additionalProperties": false,
      "required": ["source_raster_width_px", "source_raster_height_px", "source_projected_width_px", "source_projected_height_px", "source_distance_m", "target_distance_m", "scale", "target_projected_width_px", "target_projected_height_px", "orientation_deg", "rotated_raster_width_px", "rotated_raster_height_px", "target_center_px", "target_top_left_px", "vehicle_depth_m", "camera", "projection_model", "renderer_version"],
      "properties": {
        "source_raster_width_px": {"type": "integer", "minimum": 1}, "source_raster_height_px": {"type": "integer", "minimum": 1}, "source_projected_width_px": {"type": "integer", "minimum": 1}, "source_projected_height_px": {"type": "integer", "minimum": 1},
        "source_distance_m": {"type": "number", "exclusiveMinimum": 0}, "target_distance_m": {"type": "number", "exclusiveMinimum": 0}, "scale": {"type": "number", "exclusiveMinimum": 0}, "target_projected_width_px": {"type": "integer", "minimum": 1}, "target_projected_height_px": {"type": "integer", "minimum": 1},
        "orientation_deg": {"type": "number"}, "rotated_raster_width_px": {"type": "integer", "minimum": 1}, "rotated_raster_height_px": {"type": "integer", "minimum": 1},
        "target_center_px": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false}, "target_top_left_px": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": false}, "vehicle_depth_m": {"type": ["number", "null"]}, "camera": {"$ref": "#/$defs/camera"}, "projection_model": {"type": "string"}, "renderer_version": {"type": "string"}
      }
    }
  }
}
